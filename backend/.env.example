# NextGen-CCM backend secrets — copy to .env and fill in. NEVER commit .env.
# The server loads this automatically on startup (no dotenv package needed).

# OpenRouter API key — enables AI features (FR-7.1 drafting, FR-7.4 conversational editing)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional overrides (take precedence over config.xml)
# PORT=3000
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
